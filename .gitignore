# ── Large data files ──────────────────────────────────────────────────────────
data/
*.npz
*.hdf5
*.h5

# ── Checkpoints (large model weights) ────────────────────────────────────────
checkpoints/**/*.pt
checkpoints/**/*.pth
# Keep directory structure and log files
!checkpoints/**/.gitkeep
!checkpoints/**/train_log.jsonl
!checkpoints/**/meta.json

# ── Eval output images (keep, they're small) ─────────────────────────────────
# eval_output/ — included

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Virtual envs ──────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
